{
    "name": "assessment-platform/backend",
    "description": "Technology Assessment & Certification Platform - Backend API",
    "type": "project",
    "require": {
        "php": "^8.0",
        "vlucas/phpdotenv": "^5.5",
        "firebase/php-jwt": "^6.8",
        "league/oauth2-google": "^4.0",
        "league/oauth2-instagram": "^3.0",
        "intervention/image": "^2.7",
        "phpmailer/phpmailer": "^6.8",
        "endroid/qr-code": "^4.8",
        "mpdf/mpdf": "^8.1",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
